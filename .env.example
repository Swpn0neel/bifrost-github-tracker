# Copy to .env.local for local dev. On Railway, set these as service variables.

# Neon Postgres connection string (use the pooled endpoint)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# GitHub personal access token. Read-only public access is enough.
# Needed for the history backfill (stargazer timestamps require auth)
# and to get the 5,000 req/hr rate limit instead of 60.
GITHUB_TOKEN=

# Repository to track, as owner/name
GITHUB_REPO=maximhq/bifrost

# Bearer secret accepted by POST /api/refresh for external triggers
COLLECT_SECRET=

# Sign-in goes through the GTM Hub; these are optional and default to production.
# HUB_URL=https://hub.agitracker.io
# APP_PUBLIC_URL=https://github.agitracker.io
# HUB_APP_SLUG=github-tracker
# Local development only: skip the hub and act as dev@localhost (admin). Never set in production.
# HUB_SSO_DISABLED=true
